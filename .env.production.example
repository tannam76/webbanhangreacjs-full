# Copy to /opt/shoptn/.env.production on EC2 and chmod 600.
# Use a Docker Hub namespace with public shoptn-frontend and shoptn-backend repositories.
DOCKERHUB_NAMESPACE=YOUR_DOCKERHUB_USERNAME
MYSQL_DATABASE=webbanhang_db
MYSQL_USER=shoptn_app
MYSQL_PASSWORD=REPLACE_WITH_A_LONG_RANDOM_APP_PASSWORD
MYSQL_ROOT_PASSWORD=REPLACE_WITH_A_DIFFERENT_LONG_RANDOM_ROOT_PASSWORD
JWT_SECRET=REPLACE_WITH_A_RANDOM_SECRET_OF_AT_LEAST_32_CHARACTERS
