# Copy this file to .env for local Docker Compose use.
# Replace every example password before starting the database.
MYSQL_DATABASE=webbanhang_db
MYSQL_USER=shoptn_app
MYSQL_PASSWORD=replace-with-a-long-random-app-password
MYSQL_ROOT_PASSWORD=replace-with-a-different-long-random-root-password
JWT_SECRET=replace-with-a-random-secret-of-at-least-32-characters
FRONTEND_PORT=8080
